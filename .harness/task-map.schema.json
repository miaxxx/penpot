{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penpot.example/schemas/harness-task-map.schema.json",
  "title": "Penpot Harness Task Map",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "branch",
    "objective",
    "updatedAt",
    "current",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "current": {
      "type": "object",
      "required": [
        "id",
        "status",
        "sources",
        "outputs",
        "verification",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in-progress",
            "blocked",
            "completed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "task",
          "status",
          "summary",
          "commands",
          "result",
          "next"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "task": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "in-progress",
              "blocked",
              "completed"
            ]
          },
          "summary": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
